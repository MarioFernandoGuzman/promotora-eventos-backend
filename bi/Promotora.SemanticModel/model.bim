{
  "name": "Promotora",
  "compatibilityLevel": 1606,
  "model": {
    "culture": "es-GT",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "es-GT",
    "expressions": [
      {
        "kind": "m",
        "name": "ServidorBI",
        "expression": "\"localhost:5432\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "kind": "m",
        "name": "BaseDatosBI",
        "expression": "\"promotora\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "tables": [
      {
        "partitions": [
          {
            "source": {
              "expression": [
                "let",
                "    Origen = PostgreSQL.Database(ServidorBI, BaseDatosBI, [CreateNavigationProperties=false]),",
                "    Vista = Origen{[Schema=\"bi\", Item=\"vw_ventas_por_evento\"]}[Data]",
                "in",
                "    Vista"
              ],
              "type": "m"
            },
            "mode": "import",
            "name": "VentasPorEvento"
          }
        ],
        "measures": [
          {
            "name": "R-01 Compras completadas",
            "expression": "SUM(VentasPorEvento[compras_completadas])",
            "description": "Ver interpretacion y filtros en docs/REPORTES.md. Importes en blanco cuando hay mas de una moneda.",
            "formatString": "#,0"
          },
          {
            "name": "R-01 Boletos vendidos brutos",
            "expression": "SUM(VentasPorEvento[boletos_vendidos])",
            "description": "Ver interpretacion y filtros en docs/REPORTES.md. Importes en blanco cuando hay mas de una moneda.",
            "formatString": "#,0"
          },
          {
            "name": "R-01 Subtotal",
            "expression": "IF(HASONEVALUE(VentasPorEvento[moneda]), SUM(VentasPorEvento[subtotal]), BLANK())",
            "description": "Ver interpretacion y filtros en docs/REPORTES.md. Importes en blanco cuando hay mas de una moneda.",
            "formatString": "#,0.00"
          },
          {
            "name": "R-01 Comision",
            "expression": "IF(HASONEVALUE(VentasPorEvento[moneda]), SUM(VentasPorEvento[comision_plataforma]), BLANK())",
            "description": "Ver interpretacion y filtros en docs/REPORTES.md. Importes en blanco cuando hay mas de una moneda.",
            "formatString": "#,0.00"
          },
          {
            "name": "R-01 IVA",
            "expression": "IF(HASONEVALUE(VentasPorEvento[moneda]), SUM(VentasPorEvento[impuestos]), BLANK())",
            "description": "Ver interpretacion y filtros en docs/REPORTES.md. Importes en blanco cuando hay mas de una moneda.",
            "formatString": "#,0.00"
          },
          {
            "name": "R-01 Total bruto",
            "expression": "IF(HASONEVALUE(VentasPorEvento[moneda]), SUM(VentasPorEvento[total]), BLANK())",
            "description": "Ver interpretacion y filtros en docs/REPORTES.md. Importes en blanco cuando hay mas de una moneda.",
            "formatString": "#,0.00"
          }
        ],
        "name": "VentasPorEvento",
